---
import { PROGRESS_ITEMS } from '../consts';

const itemsHtml = PROGRESS_ITEMS.join('   •   ');
---

<div class="ticker" role="marquee" aria-label="Project progress updates">
	<div class="ticker-track">
		<span class="ticker-content" set:html={itemsHtml} />
		<span class="ticker-content" aria-hidden="true" set:html={itemsHtml} />
	</div>
</div>

<style>
	.ticker {
		overflow: hidden;
		background: #0090fc;
		white-space: nowrap;
		padding: 0.6em 0;
	}
	.ticker-track {
		display: inline-flex;
		animation: scroll 45s linear infinite;
	}
	.ticker-content {
		padding-right: 3em;
		color: #001830;
		font-size: 0.9em;
		font-weight: 600;
		letter-spacing: 0.02em;
	}
	.ticker-content :global(.num-red) {
		color: #d40000;
		font-weight: 800;
	}
	.ticker-content :global(.num-green) {
		color: #007a2f;
		font-weight: 800;
	}
	@keyframes scroll {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(-50%);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.ticker-track {
			animation: none;
		}
	}
</style>
