---
import { SITE_TITLE } from '../consts';
const today = new Date();
---

<footer>
	<p>&copy; {today.getFullYear()} {SITE_TITLE}. All rights reserved.</p>
	<p>Contact: <a href="mailto:hello@artificialamateur.com">hello@artificialamateur.com</a></p>
</footer>
<style>
	footer {
		padding: 2em 1em 6em 1em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: rgb(var(--gray));
		text-align: center;
	}
	footer p {
		margin: 0;
	}
	footer p + p {
		margin-top: 0.5em;
	}
	footer a {
		color: rgb(var(--gray));
	}
	footer a:hover {
		color: var(--accent);
	}
</style>
