---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Artificial Amateur</h1>
			<p>{SITE_DESCRIPTION}</p>
			<p>
				This is a running log of what I try, what works, what doesn't, and what I pick up along
				the way. Head over to the <a href="/blog">blog</a> to read the latest, or check out the
				<a href="/about">about page</a> to learn more about the project.
			</p>
		</main>
		<Footer />
	</body>
</html>
